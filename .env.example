# Copy to .env and fill in real values. Never commit .env.

# Supabase project (Zampa shared commons)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Project context — UUID of the project in Supabase projects table
# For Zampa: 871f3b8a-fce4-4157-ae3c-5cd1cd30cd15
COMMONS_PROJECT_ID=

# Author identity — UUID of your member row in the Supabase members table
# Look up via: SELECT id, display_name FROM members WHERE project_id = '<COMMONS_PROJECT_ID>';
COMMONS_MEMBER_ID=

# Display name (used in filenames, e.g., 2026-04-29-walker-...)
COMMONS_AUTHOR_SLUG=walker

# Vault path — absolute path to your Obsidian vault root (where Zampa/ lives)
# Mac:    /Users/you/Music/Resonance
# Win:    C:\\Users\\you\\Documents\\ObsidianVault
# Linux:  /home/you/Documents/ObsidianVault
VAULT_ROOT=

# Subfolder within vault to sync — defaults to "Zampa" if unset
COMMONS_SUBFOLDER=Zampa
